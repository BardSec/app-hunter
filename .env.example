# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Entra App Auditor"
SECRET_KEY="change-this-to-a-long-random-string-in-production"

# ─── Mock Data Mode ───────────────────────────────────────────────────────────
# Set to true for development/demo — no real Microsoft tenant required.
# Set to false and fill in the Azure section below for production use.
MOCK_DATA=true

# ─── Microsoft Entra ID (not needed when MOCK_DATA=true) ──────────────────────
# Register an app in your Entra tenant and grant it these delegated permissions:
#   Application.Read.All, Directory.Read.All, User.Read
# Then add a Redirect URI: http://localhost:3333/auth/callback
AZURE_CLIENT_ID=your-app-client-id-here
AZURE_CLIENT_SECRET=your-app-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here
AZURE_REDIRECT_URI=http://localhost:3333/auth/callback

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/audit.db
