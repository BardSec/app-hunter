# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Entra App Auditor"
SECRET_KEY="change-this-to-a-long-random-string-in-production"

# ─── Mock Data Mode ───────────────────────────────────────────────────────────
# Set to true for development/demo — no real Microsoft tenant required.
# Set to false and fill in the Azure section below for production use.
MOCK_DATA=true

# ─── Microsoft Entra ID (not needed when MOCK_DATA=true) ──────────────────────
# 1. Register an app in your Entra tenant (App registrations → New registration)
# 2. Under "Supported account types" choose "Accounts in this org directory only"
# 3. Under Authentication → Add a platform → choose WEB (not SPA)
# 4. Grant these DELEGATED permissions: Application.Read.All, Directory.Read.All, User.Read
# 5. Set AZURE_REDIRECT_URI below to match exactly what you enter in the portal
#
# Local dev:   http://localhost:33333/auth/callback  (platform type: Web)
# Production:  https://your-domain.example.com/auth/callback  (platform type: Web, HTTPS required)
AZURE_CLIENT_ID=your-app-client-id-here
AZURE_CLIENT_SECRET=your-app-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here
AZURE_REDIRECT_URI=http://localhost:33333/auth/callback

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/audit.db
